#!/usr/bin/env python3
"""Pre-commit guard. Refuses: data files, large blobs, notebooks with outputs,
and anything that looks like a secret. Install with scripts/install_hooks.sh.

There is deliberately no override flag. If a refusal is wrong, fix this hook
in its own commit (reviewed), do not bypass it.
"""
import json
import re
import subprocess
import sys

MAX_BYTES = 1_000_000  # 1 MB per staged file

DATA_EXT = {
    ".tif", ".tiff", ".geotiff", ".jp2", ".hdf", ".h5", ".hdf5", ".nc", ".zarr",
    ".npy", ".npz", ".pt", ".pth", ".ckpt", ".safetensors", ".onnx", ".bin",
    ".pkl", ".pickle", ".joblib", ".parquet", ".feather", ".arrow",
    ".tar", ".gz", ".tgz", ".zip", ".7z", ".bz2", ".xz", ".rar",
    ".png", ".jpg", ".jpeg",
}
# Vector figures generated by scripts/make_figures.py and docs figures are allowed.
PDF_ALLOWED_PREFIXES = ("paper/figures/", "docs/figures/")

SECRET_NAMES = re.compile(
    r"(^|/)(\.env(\..*)?|.*\.pem|.*\.key|id_rsa.*|id_ed25519.*|kaggle\.json|"
    r"credentials\.json|client_secret.*\.json|service[-_]account.*\.json)$"
)
SECRET_PATTERNS = [
    ("GitHub token", re.compile(r"\bgh[pousr]_[A-Za-z0-9]{36,}\b")),
    ("GitHub fine-grained token", re.compile(r"\bgithub_pat_[A-Za-z0-9_]{40,}\b")),
    ("HuggingFace token", re.compile(r"\bhf_[A-Za-z0-9]{30,}\b")),
    ("AWS access key", re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z_\-]{35}\b")),
    ("OpenAI/Anthropic-style key", re.compile(r"\bsk-[A-Za-z0-9_\-]{20,}\b")),
    ("Slack token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b")),
    ("Private key block", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("Kaggle key", re.compile(r"\"key\"\s*:\s*\"[0-9a-f]{32}\"")),
]


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, check=True).stdout


def staged_files():
    out = git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z")
    return [p for p in out.decode().split("\0") if p]


def staged_blob(path):
    return git("show", f":{path}")


def check(path):
    problems = []
    low = path.lower()
    if low == "data" or low.startswith("data/"):
        problems.append("path is under root /data/ (data never goes in git)")
    ext = "." + low.rsplit(".", 1)[-1] if "." in low.rsplit("/", 1)[-1] else ""
    if low.endswith(".tar.gz"):
        ext = ".gz"
    if ext in DATA_EXT:
        problems.append(f"data/blob extension {ext}")
    if ext == ".pdf" and not low.startswith(PDF_ALLOWED_PREFIXES):
        problems.append("PDF outside paper/figures/ or docs/figures/")
    if SECRET_NAMES.search(path):
        problems.append("filename looks like a secret/credential file")

    blob = staged_blob(path)
    if len(blob) > MAX_BYTES:
        problems.append(f"file is {len(blob):,} bytes (> {MAX_BYTES:,})")

    if low.endswith(".ipynb"):
        try:
            nb = json.loads(blob)
            for i, cell in enumerate(nb.get("cells", [])):
                if cell.get("outputs"):
                    problems.append(f"notebook cell {i} has outputs")
                if cell.get("execution_count") is not None:
                    problems.append(f"notebook cell {i} has an execution_count")
        except ValueError:
            problems.append("notebook is not valid JSON")

    if ext not in DATA_EXT:
        text = blob.decode("utf-8", errors="ignore")
        for name, pat in SECRET_PATTERNS:
            if pat.search(text):
                problems.append(f"possible secret: {name}")
    return problems


def main():
    failed = False
    for path in staged_files():
        for p in check(path):
            print(f"pre-commit REFUSED {path}: {p}", file=sys.stderr)
            failed = True
    if failed:
        print("Commit blocked by .githooks/pre-commit.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
